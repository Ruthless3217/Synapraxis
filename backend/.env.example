# Choose LLM Provider: 'gemini' | 'claude' | 'groq' | 'mistral' | 'cohere'
LLM_PROVIDER=gemini

# ─── Google Gemini Configuration (Google AI Studio) ───
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini/gemini-2.0-flash

# ─── Groq Configuration (Ultra-fast inference) ───
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/llama-3.3-70b-versatile

# ─── Mistral AI Configuration ───
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral/mistral-large-latest

# ─── Cohere Configuration ───
COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=cohere/command-r-plus

# ─── Anthropic Claude Configuration (Optional) ───
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
